# ==============================================
# Campus Issue Tracker - Environment Variables
# ==============================================

# Backend Database Configuration (PostgreSQL in Docker Compose, or SQLite locally)
# For local development without Docker: sqlite:///./campus_tracker.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/campus_tracker

# JWT Authentication
JWT_SECRET=evaluation-secret-key-change-this-in-production-campus-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Port
PORT=8088

# Frontend Next.js API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8088/api/v1
